# =====================================================================
# Full configuration reference. Every value is optional; defaults shown.
# Real settings live in <project>/.env on each host (not in this file).
# To use a different file:  ENV_FILE=config/kali.env python server/api_server.py
# Shell environment variables always override values in the .env file.
#
# NOTE: keep comments on their own line. python-dotenv reads "KEY=   # text"
# as the value "# text".
# =====================================================================

# ---- Identity -------------------------------------------------------
# This host's name, used in direction labels such as windows_to_kali.
# Lowercase letters, digits and '-' only (no '_', it separates the label).
NODE_NAME=windows

# ---- API server -----------------------------------------------------
# 0.0.0.0 = all interfaces (reachable from the other host); 127.0.0.1 = local only
APP_HOST=0.0.0.0
APP_PORT=8000
# Artificial server work in ms, to make processing time vs. network time visible.
SIMULATED_WORK_MS=0

# ---- Traffic generator (client) --------------------------------------
# Phase 2 will switch this to https.
TARGET_SCHEME=http
# IP of the OTHER host: `ip addr` on Kali, `ipconfig` on Windows.
TARGET_HOST=
TARGET_PORT=8000
DEFAULT_DELAY_SECONDS=5
DEFAULT_REQUEST_COUNT=5
REQUEST_TIMEOUT_SECONDS=5
REQUEST_RETRIES=2
RETRY_BACKOFF_SECONDS=1

# ---- Logs -----------------------------------------------------------
# Relative to the project root.
LOG_DIR=logs

# ---- Observer / packet capture ----------------------------------------
# auto | tshark | tcpdump | none
CAPTURE_BACKEND=auto
# Interface from `python observer/observer.py --list-interfaces`.
#   Windows (tshark -D): a number such as 8, or \Device\NPF_{...}. Numbers can change
#                        when adapters are added/removed, so re-check them.
#   Kali: a name such as eth0 / eth1.
OBSERVER_INTERFACE=
# BPF filter. Empty = "tcp port <APP_PORT>".
CAPTURE_FILTER=
# Only needed if tshark is not on PATH and not in the default Wireshark folder.
TSHARK_PATH=
OBSERVER_MERGE_WINDOW_SECONDS=2
# Optional IP -> name map, used for the direction label when a packet has no
# X-Sender / X-Receiver header. Example: <WINDOWS_IP>=windows,<KALI_IP>=kali
PEER_NAMES=

# ---- Phase 2: HTTPS/TLS -----------------------------------------------
# Server certificate + key for THIS host's API server. Both set = HTTPS, both empty = HTTP.
# Relative paths are resolved from the project root.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Lab CA the traffic generator trusts when TARGET_SCHEME=https. Verification is never disabled.
TLS_CA_FILE=

# ---- Phase 3 (not used yet) -------------------------------------------
# Never commit a real key.
# FERNET_KEY=
# FERNET_KEY_FILE=secrets/fernet.key

# ---------------------------------------------------------------------
# Example: Windows host (.env)             Example: Kali host (.env)
#   NODE_NAME=windows                        NODE_NAME=kali
#   TARGET_HOST=<KALI_IP>                    TARGET_HOST=<WINDOWS_IP>
#   OBSERVER_INTERFACE=<number from -D>      OBSERVER_INTERFACE=<eth0/eth1>
#   # Phase 2:                               # Phase 2:
#   TLS_CERT_FILE=secrets/windows.pem        TLS_CERT_FILE=secrets/kali.pem
#   TLS_KEY_FILE=secrets/windows.key         TLS_KEY_FILE=secrets/kali.key
#   TARGET_SCHEME=https                      TARGET_SCHEME=https
#   TLS_CA_FILE=secrets/ca.pem               TLS_CA_FILE=secrets/ca.pem
# ---------------------------------------------------------------------
