# Copy to .env on EACH host and fill in the values for that host.
#   Windows:  Copy-Item .env.example .env
#   Kali:     cp .env.example .env
# See config/example.env for a fully commented reference with Windows and Kali examples.

# Name of THIS host. Used in direction labels (windows_to_kali). Lowercase, no underscores.
NODE_NAME=windows

# API server bind address/port. 0.0.0.0 = reachable from the other host.
APP_HOST=0.0.0.0
APP_PORT=8000

# The OTHER host (the one this host's traffic generator sends to).
TARGET_HOST=
TARGET_PORT=8000

# Traffic generator defaults (can be overridden with --count / --delay).
DEFAULT_DELAY_SECONDS=5
DEFAULT_REQUEST_COUNT=5
REQUEST_TIMEOUT_SECONDS=5
REQUEST_RETRIES=2

# Observer / packet capture. Leave OBSERVER_INTERFACE empty until you have listed interfaces:
#   python observer/observer.py --list-interfaces
OBSERVER_INTERFACE=
CAPTURE_FILTER=
CAPTURE_BACKEND=auto

# ---- Phase 2: HTTPS/TLS (leave empty for plain HTTP) ----
# Create certificates with scripts/make_certs.py (see README section 15).
# Server side (this host's API server):
TLS_CERT_FILE=
TLS_KEY_FILE=
# Client side (talking to the other host): set TARGET_SCHEME=https and trust the lab CA.
TARGET_SCHEME=http
TLS_CA_FILE=
